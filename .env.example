# Environment
ENVIRONMENT=production

# Database (Use PostgreSQL on Vercel, not SQLite)
# Example: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost/mri_ai

# Frontend URL
FRONTEND_URL=https://your-project.vercel.app

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# JWT Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=480

# Storage directories (Vercel uses /tmp for temp storage)
STORAGE_DIR=/tmp/storage
REPORTS_DIR=/tmp/storage/reports

# AI Configuration
AI_MODE=local
AI_HTTP_URL=http://localhost:8001
AI_WEIGHTS_DIR=../ai/weights

# LLM Configuration (Optional)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4-mini
